{
  "uid": "portfolio-sample",
  "title": "portfolio-sample",
  "description": "Request rate, error ratio, latency, and pod restarts for the portfolio-sample service. Rates use http_requests_total and http_request_duration_seconds from the application /metrics endpoint. Restarts use kube_pod_container_status_restarts_total.",
  "tags": [
    "portfolio-sample"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "namespace",
        "type": "custom",
        "query": "portfolio-sample",
        "current": {
          "selected": true,
          "text": "portfolio-sample",
          "value": "portfolio-sample"
        },
        "options": [
          {
            "selected": true,
            "text": "portfolio-sample",
            "value": "portfolio-sample"
          }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests per second",
      "description": "Live series from this cluster. Empty means the metric has not been scraped yet.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{namespace=\"$namespace\",path=~\"/api/.+\"}[$__rate_interval]))",
          "legendFormat": "Requests per second",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error ratio",
      "description": "Live series from this cluster. Empty means the metric has not been scraped yet.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
