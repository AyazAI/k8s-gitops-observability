        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\",path=~\"/api/.+\"}[$__rate_interval])))",
          "legendFormat": "p95 latency",
          "datasource": {
            "type": "prometheus",
